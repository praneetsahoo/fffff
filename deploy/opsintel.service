[Unit]
Description=OpsIntel web application (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=opsintel
Group=opsintel
WorkingDirectory=/opt/opsintel/app
EnvironmentFile=/etc/opsintel/opsintel.env
# One worker on purpose: uploads are processed by a single in-process background queue,
# which guarantees two uploads never write the same order ids at the same time.
ExecStart=/opt/opsintel/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=always
RestartSec=3
TimeoutStopSec=60

# Hardening: the app writes only to S3 and RDS, never to local disk.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

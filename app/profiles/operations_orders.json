{
  "name": "operations_orders",
  "title": "Operations Orders",
  "description": "Order-level operational records from regional sales and fulfilment teams.",
  "key": "order_id",
  "roles": {
    "date": "order_date",
    "category": "category",
    "region": "region",
    "city": "city",
    "status": "status",
    "quantity": "quantity",
    "price": "unit_price",
    "delivery_days": "delivery_days"
  },
  "sla_days": 5,
  "columns": [
    {"name": "order_id", "type": "string", "required": true,
     "pattern": "^ORD-\\d{6}$", "case": "upper"},
    {"name": "order_date", "type": "date", "required": true,
     "formats": ["%Y-%m-%d", "%d/%m/%Y", "%d-%b-%Y"],
     "min": "2020-01-01", "not_future": true},
    {"name": "region", "type": "string", "required": true, "case": "title",
     "allowed": ["North", "South", "East", "West", "Central"],
     "synonyms": {"N": "North", "S": "South", "E": "East", "W": "West",
                  "Northern": "North", "Southern": "South", "Eastern": "East", "Western": "West"}},
    {"name": "state", "type": "string", "required": false, "case": "title", "fill": "Unknown"},
    {"name": "city", "type": "string", "required": true, "case": "title",
     "synonyms": {"Bombay": "Mumbai", "Bangalore": "Bengaluru", "Calcutta": "Kolkata",
                  "Madras": "Chennai", "Delhi Ncr": "Delhi", "New Delhi": "Delhi",
                  "Gurgaon": "Gurugram"}},
    {"name": "category", "type": "string", "required": true, "case": "title",
     "allowed": ["Electronics", "Grocery", "Apparel", "Home & Kitchen", "Health & Beauty"],
     "synonyms": {"Home And Kitchen": "Home & Kitchen", "Home&Kitchen": "Home & Kitchen",
                  "Health And Beauty": "Health & Beauty", "Groceries": "Grocery",
                  "Clothing": "Apparel"}},
    {"name": "product", "type": "string", "required": true, "case": "title"},
    {"name": "quantity", "type": "integer", "required": true, "min": 1, "max": 1000},
    {"name": "unit_price", "type": "decimal", "required": true, "min": 0.01, "max": 1000000},
    {"name": "status", "type": "string", "required": true, "case": "title",
     "allowed": ["Delivered", "Shipped", "Pending", "Cancelled", "Returned"],
     "synonyms": {"Completed": "Delivered", "Canceled": "Cancelled", "In Transit": "Shipped",
                  "Dispatched": "Shipped", "Processing": "Pending"}},
    {"name": "delivery_days", "type": "integer", "required": false, "min": 0, "max": 60}
  ]
}

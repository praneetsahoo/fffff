# Copy to .env for local development. Never commit .env.

# --- Database ---
# Local dev/tests: SQLite file. On AWS: leave DB_URL empty and set DB_HOST etc.;
# the password is read at startup from SSM Parameter Store (SecureString).
DB_URL=sqlite:///./data/opsintel.db
# DB_HOST=opsintel-db.xxxxxx.ap-southeast-2.rds.amazonaws.com
# DB_PORT=3306
# DB_NAME=opsintel
# DB_USER=opsintel_app
# DB_PASSWORD_SSM_PARAM=/opsintel/db/password
# DB_SSL_CA=/opt/opsintel/rds-ca.pem

# --- Storage ---
# local = files under data/storage (dev); s3 = AWS S3 (production)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
# S3_BUCKET=opsintel-data-<account-id>
AWS_REGION=ap-southeast-2

# --- App ---
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
